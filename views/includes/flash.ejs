<% if(success && success.length){ %>
    <div class="alert theme-success col-6 offset-3 mt-3" role="alert">
        <%= success %>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if(error && error.length){ %>
    <div class="alert theme-danger col-6 offset-3 mt-3" role="alert">
        <%= error %>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>



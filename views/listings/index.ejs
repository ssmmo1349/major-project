<% layout("./layouts/boilerplate") %>
<body>
    <!-- <h3>All Listings</h3> -->
    <!-- <form action="/listings/new" method="get">
        <button>crate new listing!</button>
    </form> -->
    <div id="filters">
        <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-archway"></i></div>
            <p>Iconic cities</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>
        <div class="filter">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>castles</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing pools</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-umbrella-beach"></i></div>
            <p>Beaches</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-tents"></i></div>
            <p>Camping</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-tractor"></i></div>
            <p>Farm house</p>
        </div>
        <div class="filter">
            <div><i class="fa-regular fa-snowflake"></i></div>
            <p>Arctic</p>
        </div>

        <div class="tax-toggle">
                <label for="switchsecondary">Display total before taxes</label>
                <div class="switch theme-secondary">
                    <input type="checkbox" value="" id="switchsecondary" role="switch" switch>
                </div>
            </div>
        </div>

    </div>
    <div class="container mt-3">
        <div class="row  lg:row-cols-3 md:row-cols-2 row-cols-1">
            <% for(let listing of allListings){ %>
                <div class="card col mt-4 listing-card">
                    <div class="card-body">
                        <a href="/listings/<%= listing._id %>" class="listing-link">
                            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                            <div class="card-img-overlay"></div>
                             <div class="card-body">
                                <h5 class="mt-2 mb-0 listing-title"><b><%= listing.title %></b></h5>
                                <p class="card-text fg-2"><%= listing.description %></p>
                                <small class="fg-body">&#x20B9; <%= listing.price.toLocaleString("en-IN") %> / night <i class="tax-info">&nbsp; &nbsp; +18% GST</i></small>
                             </div>
                        </a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
                    
</body>



<% layout("./layouts/boilerplate") %>
<body>
  <div class="row">
    <div class="col-8 offset-2">
      <h3>Create a new Listing</h3>
      <form action="/listings" method="post" data-bs-validate="valid" novalidate enctype="multipart/form-data">
        <div class="mb-3">
          <label for="title" class="form-label">Enter Title </label>
          <input
            type="text"
            id="title"
            name="listing[title]"
            placeholder="enter title"
            class="form-control"
            required
          />
          <div class="valid-feedback">Title looks good</div>
          <div class="invalid-feedback">Title not looking good</div>
        </div>
       

        <div class="mb-3" >
          <label for="description" class="form-label"
            >Enter Description
          </label>
          <textarea
            name="listing[description]"
            rows="10"
            cols="30"
            placeholder="enter description"
            class="form-control"
            id="description"
            required
          ></textarea>
          <div class="valid-feedback">Shyt description!!!</div>
            <div class="invalid-feedback">Bro,lame description</div>
        </div>
        

        <div class="mb-3">
          <label for="image" class="form-label">Upload an image </label>
          <input
            type="file"
            name="listing[image]"
            class="form-control"
            id="image"
            required
          />
          <div class="invalid-feedback">add an image</div>
        </div>

        <div class="row mb-3">
          <div class="md:col-4">
            <label for="price" class="form-label">Enter Price </label>
            <input
              type="number"
              name="listing[price]"
              placeholder="1200"
              class="form-control"
              id="price"
              required
            />
                          <div class="valid-feedback">Ahhhh! not bad not bad.</div>
          <div class="invalid-feedback">ohhh my gawdd. Add some descent price.</div>
          </div>

          <div class="md:col-8">
            <label for="country" class="form-label">Enter Country</label>
            <input
              type="text"
              name="listing[country]"
              placeholder="enter country"
              class="form-control"
              id="country"
              required
            />
                          <div class="valid-feedback">that's a fine ahh country</div>
          <div class="invalid-feedback">add your country or else no one is going there.</div>
          </div>
        </div>
    
        <div class="mb-3">
          <label for="location" class="form-label">Enter Location</label>
          <input
            type="text"
            name="listing[location]"
            placeholder="enter location"
            class="form-control"
            id="location"
            required
          />
                      <div class="valid-feedback">Woowww, that's the place you are renting!!!</div>
          <div class="invalid-feedback">I think you should add your location</div>
        </div>
        

        <button
          type="submit"
          class="theme-inverse btn-outline btn-solid btn-lg fg-body mb-4 mt-3"
        >
          add listing!
        </button>

      </form>
    </div>
  </div>
</body>

<% layout("./layouts/boilerplate") %>
<script>
   const mapToken = "<%= process.env.MAP_TOKEN %>";
   const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
</script>
<body>
  <div class="row">
    <div class="col-8 offset-3 mt-3 mb-3">
      <h3><b><%= listing.title %></b></h3>
    </div>
    <div class="card col-5 offset-3 listing-card">
      <img
        src="<%= listing.image.url %>"
        alt="listing_image"
        class="card-img-top show-img"
      />
      <div class="card-body">
        <p class="card-text">Owned by <i><%= listing.owner.username %></i></p>
        <p class="card-text"><%= listing.description %></p> 
        <p class="card-text"><%= listing.location %></p>  
        <p class="card-text"><%= listing.country %></p>  
        <p class="card-text">&#x20B9; <%= listing.price.toLocaleString("en-IN") %></p>   
      </div>
    </div>
  </div>
  <div class="row">
    <% if(currUser && currUser._id.equals(listing.owner._id)){ %>
    <div class="col-5 offset-3 show-btn">
      <a
        href="/listings/<%= listing._id %>/edit"
        class="btn theme-inverse btn-outline btn-solid btn-lg fg-body mb-4 mt-3 me-4"
        >Edit</a
      >
      <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
        <button
          class="theme-inverse btn-outline btn-solid btn-lg fg-body mb-4 mt-3"
        >
          Delete
        </button>
      </form>
    </div>
    <% } %>

    <% if(currUser){ %>
    <div class="col-5 offset-3 mb-3 mt-3">
      <hr />
      <h4>Leave a Review</h4>
      <form action="/listings/<%= listing._id %>/reviews" method="post" data-bs-validate="valid" novalidate>
        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <fieldset class="starability-slot">
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
        </div>
        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea
            name="review[comment]"
            id="comment"
            cols="30"
            rows="5"
            class="form-control"
            required
          ></textarea>
          <div class="invalid-feedback">Please, Enter some comment before submitting.</div>
        </div>
        <div class="mb-3 mt-3">
          <button
            class="btn theme-inverse btn-outline btn-solid btn-lg fg-body mb-4 mt-3"
          >
            Submit
          </button>
        </div>
      </form>
      <% } %>
      
      </div>
      <div class="col-5 offset-3 mb-3 mt-3">
      <hr>
      
      <% if(listing.reviews.length>0) {%>
      <div class="row">
        <p><b>All Reviews</b></p>
        <% for(let review of listing.reviews){ %>
        <div class="card col-5 mb-3 me-7 ms-3">
          <div class="card-body">
            <h4 class="card-title">@<%= review.author.username %></h4>
            <p class="starability-result card-text" data-rating="<%= review.rating%>"></p>
            <p class="card-text"><%= review.comment%></p>
          </div>
          <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
            <button class="btn theme-inverse btn-outline btn-solid btn-lg fg-body mb-4 mt-3">Delete</button>
          </form>
        </div>    
        <% } %>
      </div>
      <% } %>
    </div>

    <div class="row">
        <div class="col-5 offset-3 mb-4">
          <h3>Where You'll Be</h3>
          <div id="map"></div>
        </div>
      </div>
  </div>
<script src="/map.js"></script>
</body>

